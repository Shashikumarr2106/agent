# ==============================================================================
# AI Data Analyst Agent — Environment Configuration
# Reference Architecture: Flow.md
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env`:
#      cp .env.example .env
# 2. Fill in the values for your environment (API keys, database, etc.).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# Used by: backend/main.py, backend/core/config.py
# ------------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:8000"]
DATA_DIR=./data

# ------------------------------------------------------------------------------
# 2. DATABASE & PGVECTOR SETTINGS
# Used by: backend/services/database.py, backend/services/skill_service.py
# If DATABASE_URL is not set or PostgreSQL is unavailable, the application
# automatically falls back to SQLite (`sqlite:///./agent.db`) for zero-friction local testing.
# ------------------------------------------------------------------------------
# PostgreSQL connection string:
# Format: postgresql+psycopg://username:password@host:port/database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agent_db

# Individual credentials (used by docker-compose.yml):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agent_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. LLM (LARGE LANGUAGE MODEL) PROVIDER
# Used by: backend/graph/planner.py, backend/graph/sql_node.py, backend/graph/skill_node.py
# Supported providers: openai, google, anthropic, ollama, mock (for offline testing)
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# API Keys (Provide the one corresponding to your chosen LLM_PROVIDER):
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama settings (if using local LLM):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ------------------------------------------------------------------------------
# 4. EMBEDDINGS (FOR SKILL VECTOR SEARCH VIA PGVECTOR)
# Used by: backend/services/embedding.py, backend/services/skill_service.py
# Supported providers: openai, google, sentence_transformers, deterministic (offline fallback)
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ------------------------------------------------------------------------------
# 5. MCP (MODEL CONTEXT PROTOCOL) SETTINGS
# Used by: backend/mcp/server.py, backend/mcp/client.py
# ------------------------------------------------------------------------------
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001
MCP_TRANSPORT=stdio

# ------------------------------------------------------------------------------
# 6. SQL SAFETY & EXECUTION LIMITS
# Used by: backend/mcp/data_tools.py, backend/graph/sql_node.py
# Enforces Section 37 in Flow.md (SELECT-only queries, row limits, timeouts)
# ------------------------------------------------------------------------------
SQL_ROW_LIMIT=1000
SQL_QUERY_TIMEOUT_SECONDS=30
MAX_UPLOAD_SIZE_MB=100
